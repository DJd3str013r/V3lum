{
 "schema": "v3lum.rule/1",
 "id": "t_threshold_shared_ip",
 "version": "1",
 "title": "Several domains share one IP",
 "severity": "medium",
 "criterion": "test rule (threshold)",
 "references": [
  "https://github.com/smicallef/spiderfoot"
 ],
 "attack": [
  "T1583.001"
 ],
 "false_positives": "synthetic test rule",
 "collections": [
  {
   "name": "domains",
   "entity_types": [
    "domain"
   ],
   "filters": [
    {
     "field": "relation:resolves_to",
     "op": "exists"
    }
   ]
  }
 ],
 "analysis": {
  "method": "threshold",
  "minimum": 3
 },
 "headline": "{count} domains resolve to {value}",
 "recommendation": "Review the listed entities.",
 "aggregation": {
  "field": "relation:resolves_to"
 },
 "tags": [
  "infrastructure"
 ],
 "suppress": [
  {
   "name": "parked",
   "when": [
    {
     "field": "tag:parked",
     "op": "exists"
    }
   ],
   "to": "possible",
   "severity": "low",
   "reason": "a parked domain shares hosting by design"
  }
 ]
}
