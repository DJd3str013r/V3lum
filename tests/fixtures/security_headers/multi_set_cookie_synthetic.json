{
 "url": "https://portal.example.com/login",
 "status": 200,
 "headers": [
  [
   "Content-Type",
   "text/html; charset=utf-8"
  ],
  [
   "Strict-Transport-Security",
   "max-age=86400"
  ],
  [
   "Content-Security-Policy",
   "default-src 'self'; script-src 'self' 'unsafe-inline'; object-src 'none'; frame-ancestors 'self'"
  ],
  [
   "X-Content-Type-Options",
   "nosniff"
  ],
  [
   "Referrer-Policy",
   "no-referrer-when-downgrade"
  ],
  [
   "X-Powered-By",
   "PHP/7.4.3"
  ],
  [
   "Server",
   "Apache/2.4.41 (Ubuntu)"
  ],
  [
   "Set-Cookie",
   "PHPSESSID=abcdef0123456789; path=/; expires=Wed, 21 Oct 2026 07:28:00 GMT"
  ],
  [
   "Set-Cookie",
   "remember_token=0000000000; Expires=Thu, 01 Jan 2027 00:00:00 GMT; Secure; Path=/"
  ],
  [
   "Set-Cookie",
   "__Host-csrf=xyz; Secure; Path=/; Domain=example.com; SameSite=Strict"
  ],
  [
   "Set-Cookie",
   "lang=pt-BR; Path=/; SameSite=Lax; Secure"
  ],
  [
   "Set-Cookie",
   "tracking=1; SameSite=None"
  ]
 ]
}
