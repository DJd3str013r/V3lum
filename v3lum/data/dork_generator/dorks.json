{
  "schema": "v3lum.dork_pack/1",
  "pack": "dorks",
  "title": "V3LUM search-engine dork pack (P306)",
  "notes": "V3LUM-owned dorks written from search-operator facts (site:, filetype:, inurl:, intitle:, ip:, url:). Nothing is copied from sitedorks or msdorkdump (AGPL), PhoneInfoga (GPL) or dorks_hunter / Fast-Google-Dorks-Scan (no licence) (P306 cond 2, A6). Links only: V3LUM never queries, scrapes or renders a search engine (cond 1). Placeholders are substituted with re.sub through validators (never str.format); {sites} expands the row's site_list. Every rendered query keeps <= 32 words and fewer than 30 site: operators (cond 2).",
  "engines": {
    "google": {
      "host": "www.google.com",
      "base": "https://www.google.com/search?q="
    },
    "bing": {
      "host": "www.bing.com",
      "base": "https://www.bing.com/search?q="
    },
    "duckduckgo": {
      "host": "duckduckgo.com",
      "base": "https://duckduckgo.com/?q="
    }
  },
  "site_lists": {
    "collab_paste": {
      "title": "Collaboration and paste sites (domains and brands only, cond 5)",
      "sites": [
        "trello.com",
        "atlassian.net",
        "pastebin.com",
        "docs.google.com"
      ]
    },
    "br_complaints": {
      "title": "Brazilian complaint sites",
