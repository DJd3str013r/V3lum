        "x.com",
        "facebook.com",
        "tiktok.com",
        "youtube.com",
        "github.com"
      ]
    }
  },
  "dorks": [
    {
      "id": "exp_documents",
      "family": "exposure",
      "group": "exposure",
      "label": "Documents indexed on the domain",
      "query": "site:{domain} (filetype:pdf OR filetype:docx OR filetype:doc OR filetype:xlsx OR filetype:xls OR filetype:pptx OR filetype:odt OR filetype:csv)",
      "entity_types": [
        "domain"
      ],
      "engines": [
        "google",
        "bing",
        "duckduckgo"
      ],
      "privacy": false,
      "scope": "typed_or_own",
      "curated": true,
      "notes": ""
    },
    {
      "id": "exp_configs",
      "family": "exposure",
      "group": "exposure",
      "label": "Config, backup, database and log files",
      "query": "site:{domain} (filetype:env OR filetype:conf OR filetype:ini OR filetype:cfg OR filetype:bak OR filetype:sql OR filetype:log OR filetype:old)",
      "entity_types": [
        "domain"
      ],
      "engines": [
        "google",
        "bing",
        "duckduckgo"
      ],
      "privacy": false,
      "scope": "typed_or_own",
      "curated": true,
      "notes": ""
    },
    {
      "id": "exp_directory_listing",
      "family": "exposure",
      "group": "exposure",
      "label": "Directory listings",
      "query": "site:{domain} intitle:\"index of\"",
