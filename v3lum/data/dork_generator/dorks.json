        "docs.google.com/forms",
        "forms.office.com",
        "forms.gle",
        "typeform.com",
        "jotform.com"
      ]
    },
    "storage": {
      "title": "Public cloud-storage shares",
      "sites": [
        "drive.google.com",
        "dropbox.com",
        "onedrive.live.com",
        "1drv.ms",
        "mega.nz",
        "box.com"
