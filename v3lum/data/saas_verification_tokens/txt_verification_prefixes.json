{
  "schema": "v3lum.txt_verification_prefixes/1",
  "name": "txt_verification_prefixes",
  "version": "2026-11-26",
  "licence": "V3LUM own work (proprietary-internal, A6 bundle-safe). Vendor and product names are trademarks of their owners and are used only to name the service.",
  "provenance": "Compiled for V3LUM (P342 FC2) from public DNS observations - apex TXT of google.com and cloudflare.com (cloudflare-dns.com and dns.google, 2026-11-26) and atlassian.com (the gaps__saas_tenants research request re-recorded on 2026-11-26) - the council/synthesizer list and vendor documentation knowledge. No third-party prefix list was copied. 'seen': live = observed in a public TXT answer on the date above; council = named by the P342 final conditions or synthesizer; doc = vendor documentation knowledge, not observed (review before relying on it).",
  "match": "Case-insensitive prefix match on the whole TXT string after DoH unquoting (multi-string records concatenated). The longest matching prefix wins. Prefixes include their separator where the vendor uses one, so 'ms=' never matches 'ms-foo'. Policy records (SPF, DMARC, DKIM, MTA-STS, TLS-RPT, BIMI) are never verification tokens.",
  "policy_prefixes": ["v=spf1", "v=dmarc1", "v=dkim1", "v=stsv1", "v=tlsrptv1", "v=bimi1", "spf2.0/"],
  "categories": {
    "idp_sso": {"label": "identity provider / SSO", "hint": "sign-in pages of this brand are the most imitated phishing lures (credential harvesting, adversary-in-the-middle); use it in phishing simulations and brand monitoring"},
    "office_suite": {"label": "mail and office suite", "hint": "shared-document, mailbox-quota and sign-in lures imitate this brand"},
    "helpdesk_itsm": {"label": "helpdesk / ITSM", "hint": "fake ticket, password-reset and IT-support lures (including helpdesk vishing) imitate this brand"},
    "e_signature": {"label": "e-signature", "hint": "'document waiting for your signature' lures imitate this brand"},
    "security_awareness": {"label": "security awareness / phishing simulation", "hint": "simulated phishing may already run with this vendor: coordinate before simulations and do not mistake its campaigns for attacks"},
    "payments_finance": {"label": "payments / finance", "hint": "invoice, payout and payment-change (BEC) lures imitate this brand"},
    "video_conf": {"label": "video conferencing / telephony", "hint": "fake meeting invitations and voicemail notifications imitate this brand"},
    "collaboration": {"label": "collaboration workspace", "hint": "workspace-invitation and shared-board lures imitate this brand"},
    "file_sharing": {"label": "file sharing / documents", "hint": "shared-file lures imitate this brand"},
    "mdm_endpoint": {"label": "device management / endpoint", "hint": "fake enrolment, compliance and update prompts imitate this brand"},
    "password_manager": {"label": "password manager", "hint": "fake vault-locked or re-authentication prompts imitate this brand"},
    "remote_access": {"label": "remote access / remote support", "hint": "remote-support brands are abused in tech-support scams and fake support sessions"},
    "dev_platform": {"label": "developer / cloud platform", "hint": "fake security alerts and OAuth-consent lures imitate this brand; check for leaked tokens of this platform"},
    "ai_platform": {"label": "AI platform", "hint": "fake workspace invitations imitate this brand; review the workspace's data-sharing settings"},
    "security_tools": {"label": "security service", "hint": "fake breach or security-alert notifications can imitate this vendor; ASM inventory"},
    "social_ads": {"label": "social media / ads", "hint": "fake 'page restricted' and ad-account lures imitate this brand"},
    "marketing_crm": {"label": "marketing / CRM / analytics", "hint": "ASM inventory; low phishing value"},
    "pki_certificates": {"label": "certificates / PKI", "hint": "ASM inventory (TLS or S/MIME certificate issuance)"},
    "privacy_compliance": {"label": "privacy / compliance", "hint": "ASM inventory"},
    "web_seo": {"label": "webmaster / SEO tools", "hint": "ASM inventory"},
    "other": {"label": "other SaaS", "hint": "ASM inventory"}
  },
  "phishing_groups": {
    "idp": {"label": "identity providers / SSO (sign-in pages attackers imitate)", "categories": ["idp_sso"]},
